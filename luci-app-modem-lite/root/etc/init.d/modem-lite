#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/modem-lite/modemd
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

# Restart so a changed APN, PIN or interval is applied immediately.
reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger modem-lite
}
